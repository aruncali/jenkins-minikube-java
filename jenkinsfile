pipeline {
    agent {
        docker {
            image 'arunubuntu/jenkins-java-agent:latest'
            args '-u root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKERHUB_USERNAME = 'arunubuntu'
        IMAGE_NAME = 'java-application'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_AGENT_IMAGE = 'arunubuntu/jenkins-java-agent:latest'


    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn clean verify'
            }
        }

       stage('SonarQube Analysis') {
            steps {
            withSonarQubeEnv('SonarQube') {
            sh '''
                set -e

                mkdir -p "$WORKSPACE/.sonar/cache"

                mvn -B \
                  -Dsonar.projectKey=java-application \
                  -Dsonar.userHome="$WORKSPACE/.sonar" \
                  org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar
            '''
        }
    }
}
      stage('Check SonarQube Connectivity') {
         steps {
            sh '''
               echo "Checking SonarQube connectivity..."

               curl -v --connect-timeout 5 \
               http://127.0.0.1:9000/api/system/status
             '''
           }
         }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DH_PASSWORD" | docker login \
                          -u "$DH_USER" --password-stdin

                        docker push \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}

                        docker push \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest

                        docker logout
                    '''
                }
            }
        }


stage('Push Updated Manifest to GitHub') {
    steps {
        withCredentials([
            usernamePassword(
                credentialsId: 'github-creds',
                usernameVariable: 'GIT_USERNAME',
                passwordVariable: 'GIT_TOKEN'
            )
        ]) {
            sh '''
                set -eu
                set +x

                git config user.name "aruncali"
                git config user.email "soloman747474@gmail.com"

                git add k8s/deployment-service.yaml

                if ! git diff --cached --quiet; then
                    git commit -m "Update Kubernetes image to build ${IMAGE_TAG}"

                    git push \
                      "https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/k8s/deployment-service.yaml" \
                      HEAD:main
                else
                    echo "No manifest changes to commit."
                fi
            '''
        }
    }
}


    }

    post {
        success {
            echo 'Build, analysis and image push succeeded.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
