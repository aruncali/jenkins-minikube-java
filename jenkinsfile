pipeline {
    agent {
        docker {
            image 'arunubuntu/jenkins-java-agent:latest'
            args '-u root --network devops-network -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKERHUB_USERNAME = 'arunubuntu'
        IMAGE_NAME = 'java-application'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn clean verify'
            }
        }

        stage('Check SonarQube Connectivity') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        set -eu

                        echo "Checking SonarQube connectivity..."

                        curl -fsS --connect-timeout 5 \
                          "$SONAR_HOST_URL/api/system/status"
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        set -eu

                        mkdir -p "$WORKSPACE/.sonar/cache"

                        mvn -B \
                          -Dsonar.projectKey=java-application \
                          -Dsonar.userHome="$WORKSPACE/.sonar" \
                          org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      -t "${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}" \
                      -t "${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest" .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "$DH_PASSWORD" | docker login \
                          -u "$DH_USER" --password-stdin

                        docker push \
                          "${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}"

                        docker push \
                          "${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest"

                        docker logout
                    '''
                }
            }
        }

        stage('Update Kubernetes Image Tag') {
            steps {
                sh '''
                    set -eu

                    sed -i \
                      "s|image: arunubuntu/java-application:.*|image: arunubuntu/java-application:${IMAGE_TAG}|" \
                      k8s/deployment-service.yaml

                    echo "Updated Kubernetes manifest:"
                    grep 'image:' k8s/deployment-service.yaml
                '''
            }
        }

        stage('Push Updated Manifest to GitHub') {
            steps {
                withCredentials([
                 string(
                     credentialsId: 'github-creds',
                     variable: 'GIT_TOKEN'
                     )
               ])  {
                    sh '''
                        set -eu
                        set +x

                        git config user.name "aruncali"
                        git config user.email "soloman747474@gmail.com"

                        git add k8s/deployment-service.yaml

                        if ! git diff --cached --quiet; then
                            git commit -m "Update Kubernetes image to build ${IMAGE_TAG}"

                            ASKPASS="$(mktemp)"
                            trap 'rm -f "$ASKPASS"' EXIT

                            cat > "$ASKPASS" <<'EOF'
#!/bin/sh
case "$1" in
    *Username*) printf '%s\\n' "aruncali" ;;
    *Password*) printf '%s\\n' "$GIT_TOKEN" ;;
    *) exit 1 ;;
esac
EOF

                            chmod 700 "$ASKPASS"
                            export GIT_ASKPASS="$ASKPASS"
                            export GIT_TERMINAL_PROMPT=0

                            git push \
                              "https://github.com/aruncali/jenkins-minikube-java/k8s/deployment-service.yaml" \
                              HEAD:main
                        else
                            echo "No manifest changes to commit."
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Build, SonarQube analysis, Docker push and GitOps manifest update succeeded.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}
