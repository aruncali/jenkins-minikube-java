
pipeline {
    agent {
        docker {
            image 'arunubuntu/jenkins-java-agent:latest'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        DOCKERHUB_USERNAME = 'arunubuntu'
        IMAGE_NAME = 'java-application'
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_AGENT_IMAGE = 'arunubuntu/jenkins-java-agent:latest'


    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn clean verify'
            }
        }

       stage('SonarQube Analysis') {
          steps {
              withSonarQubeEnv('SonarQube') {
                sh '''
                  mkdir -p "$WORKSPACE/.sonar/cache"
                  mvn -B \
                    -Dsonar.projectKey=java-application \
                    -Dsonar.userHome="$WORKSPACE/.sonar" \
                     org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar
            '''
             }
           }
        }
    //  stage('Quality Gate') {
     //    steps {
      //      timeout(time: 5, unit: 'MINUTES') {
       //         waitForQualityGate abortPipeline: true
        //   }
         // } 
       //}

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -t ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG} \
                      -t ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        echo "$DH_PASSWORD" | docker login \
                          -u "$DH_USER" --password-stdin

                        docker push \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:${IMAGE_TAG}

                        docker push \
                          ${DOCKERHUB_USERNAME}/${IMAGE_NAME}:latest

                        docker logout
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Build, analysis and image push succeeded.'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
